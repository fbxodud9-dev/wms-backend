# Google Cloud SQL(PostgreSQL) 접속 정보를 하나의 URL로 입력하세요.
# 형식: postgres://사용자명:비밀번호@호스트:5432/데이터베이스명
DATABASE_URL=postgres://wms_user:CHANGE_ME@000.000.000.000:5432/wms

# Cloud SQL 공인 IP + SSL 접속 시 true로 설정 (대부분 true 권장)
DB_SSL=true

# 로그인 토큰 서명에 쓰이는 비밀키 - 반드시 무작위 긴 문자열로 변경하세요
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# 프론트엔드(Vercel) 배포 주소 - CORS 허용을 위해 필요
FRONTEND_ORIGIN=https://wms-demo-liard.vercel.app

# 서버 포트 (Render가 자동으로 PORT를 주입하므로 로컬 테스트용)
PORT=8080
